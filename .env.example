# ==========================================
# DATABASE SECRETS (Never commit real values to Git)
# ==========================================
DB_URL="jdbc:mysql://localhost:3306/tradex_db?useSSL=false&serverTimezone=UTC"
DB_USERNAME="tradex_user"
DB_PASSWORD="your_secure_db_password"

# ==========================================
# AUTHENTICATION & SMTP SECRETS
# ==========================================
JWT_SECRET="your_secure_256_bit_jwt_secret_key_here"
SMTP_USERNAME="smtp_username@example.com"
SMTP_PASSWORD="smtp_secret_password"

# ==========================================
# BACKEND INFRASTRUCTURE & CORS
# ==========================================
# Security Notice: Explicitly specify trusted production domains.
# Avoid broad wildcards like https://*.domain.com when allowCredentials(true) is enabled.
CORS_ALLOWED_ORIGIN_PATTERNS="https://trade.apextrader.com,https://apextrader.com,http://localhost:5173,http://localhost:3000"
